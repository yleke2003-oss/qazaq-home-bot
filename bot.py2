async def profile_menu(update, context):
    keyboard = [
        ["📞 АДМИНМЕН ХАБАРЛАСУ"],
        ["⭐ МЕНІҢ РЕЙТИНГІМ"],
    ]

    await update.message.reply_text(
        "👤 МЕНІҢ ПРОФИЛІМ",
        reply_markup=ReplyKeyboardMarkup(
            keyboard,
            resize_keyboard=True
        )
    )


async def my_rating(update, context):
    user_id = update.effective_user.id

    seller = db_execute(
        """
        SELECT AVG(stars) avg_rating, COUNT(*) cnt
        FROM ratings
        WHERE to_user=? AND rating_type='seller'
        """,
        (user_id,),
        fetchone=True
    )

    buyer = db_execute(
        """
        SELECT AVG(stars) avg_rating, COUNT(*) cnt
        FROM ratings
        WHERE to_user=? AND rating_type='buyer'
        """,
        (user_id,),
        fetchone=True
    )

    seller_rating = round(seller["avg_rating"], 1) if seller["avg_rating"] else 0
    buyer_rating = round(buyer["avg_rating"], 1) if buyer["avg_rating"] else 0

    text = (
        "⭐ МЕНІҢ РЕЙТИНГІМ\n\n"
        f"🏠 САТУШЫ РЕЙТИНГІ\n"
        f"⭐ {seller_rating} / 5\n"
        f"{seller['cnt']} бағалау\n\n"
        f"🔎 САТЫП АЛУШЫ РЕЙТИНГІ\n"
        f"⭐ {buyer_rating} / 5\n"
        f"{buyer['cnt']} бағалау"
    )

    await update.message.reply_text(text)


async def rating_menu(update, context):
    await my_rating(update, context)


