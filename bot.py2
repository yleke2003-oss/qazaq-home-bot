async def admin_callback(update, context):
    query = update.callback_query
    await query.answer()

    if query.from_user.id != ADMIN_ID:
        return

    action = query.data

    if action == "admin_users":
        row = db_execute(
            "SELECT COUNT(*) cnt FROM users",
            fetchone=True
        )

        await query.message.reply_text(
            f"👥 Қолданушылар: {row['cnt']}"
        )

    elif action == "admin_listings":
        row = db_execute(
            "SELECT COUNT(*) cnt FROM listings WHERE active=1",
            fetchone=True
        )

        await query.message.reply_text(
            f"🏠 Белсенді жарнамалар: {row['cnt']}"
        )

    elif action == "admin_rooms":
        row = db_execute(
            "SELECT COUNT(*) cnt FROM roommate_profiles WHERE active=1",
            fetchone=True
        )

        await query.message.reply_text(
            f"👥 Белсенді анкеталар: {row['cnt']}"
        )

    elif action == "admin_reports":
        row = db_execute(
            "SELECT COUNT(*) cnt FROM reports WHERE status='new'",
            fetchone=True
        )

        await query.message.reply_text(
            f"🚨 Жаңа шағымдар: {row['cnt']}"
        )

    elif action == "admin_stats":
        users = db_execute(
            "SELECT COUNT(*) cnt FROM users",
            fetchone=True
        )

        listings = db_execute(
            "SELECT COUNT(*) cnt FROM listings",
            fetchone=True
        )

        ratings = db_execute(
            "SELECT COUNT(*) cnt FROM ratings",
            fetchone=True
        )

        await query.message.reply_text(
            "📊 СТАТИСТИКА\n\n"
            f"👥 Қолданушылар: {users['cnt']}\n"
            f"🏠 Барлық жарнама: {listings['cnt']}\n"
            f"⭐ Бағалаулар: {ratings['cnt']}"
        )


# =========================================================
# EXPIRATION
# =========================================================

async def check_expired(context):
    expired = db_execute(
        """
        SELECT * FROM listings
        WHERE active=1
        AND datetime(expires_at) <= datetime('now')
        """,
        fetchall=True
    )

    for listing in expired:
        db_execute(
            "UPDATE listings SET active=0 WHERE id=?",
            (listing["id"],)
        )

        try:
            await context.bot.send_message(
                chat_id=listing["user_id"],
                text=(
                    "⚠️ СІЗДІҢ ЖАРНАМАҢЫЗДЫҢ МЕРЗІМІ АЯҚТАЛДЫ.\n\n"
                    "Жарнаманы тағы 14 күнге ұзартқыңыз келе ме?"
                ),
                reply_markup=InlineKeyboardMarkup([
                    [
                        InlineKeyboardButton(
                            "🔄 ҰЗАРТУ",
                            callback_data=f"renew_{listing['id']}"
                        ),
                        InlineKeyboardButton(
                            "🗑 ӨШІРУ",
                            callback_data=f"delete_expired_{listing['id']}"
                        )
                    ]
                ])
            )
        except Exception:
            pass

    expired_rooms = db_execute(
        """
        SELECT * FROM roommate_profiles
        WHERE active=1
        AND datetime(expires_at) <= datetime('now')
        """,
        fetchall=True
    )

    for profile in expired_rooms:
        db_execute(
            "UPDATE roommate_profiles SET active=0 WHERE id=?",
            (profile["id"],)
        )

        try:
            await context.bot.send_message(
                chat_id=profile["user_id"],
                text=(
                    "⚠️ Сіздің анкетаңыздың мерзімі аяқталды.\n\n"
                    "Тағы 14 күнге ұзартқыңыз келе ме?"
                ),
                reply_markup=InlineKeyboardMarkup([
                    [
                        InlineKeyboardButton(
                            "🔄 ҰЗАРТУ",
                            callback_data=f"renewroom_{profile['id']}"
                        )
                    ]
                ])
            )
        except Exception:
            pass


async def renew_listing(update, context):
    query = update.callback_query
    await query.answer()

    listing_id = int(query.data.split("_")[1])

    db_execute(
        """
        UPDATE listings
        SET active=1,
            expires_at=?
        WHERE id=? AND user_id=?
        """,
        (
            expires_in_14_days(),
            listing_id,
            query.from_user.id
        )
    )

    await query.message.edit_text(
        "✅ Жарнама тағы 14 күнге ұзартылды."
    )


async def delete_expired(update, context):
    query = update.callback_query
    await query.answer()

    listing_id = int(query.data.split("_")[2])

    db_execute(
        """
        DELETE FROM listings
        WHERE id=? AND user_id=?
        """,
        (
            listing_id,
            query.from_user.id
        )
    )

    await query.message.edit_text(
        "🗑 Жарнама өшірілді."
    )


async def renew_roommate(update, context):
    query = update.callback_query
    await query.answer()

    profile_id = int(query.data.split("_")[1])

    db_execute(
        """
        UPDATE roommate_profiles
        SET active=1,
            expires_at=?
        WHERE id=? AND user_id=?
        """,
        (
            expires_in_14_days(),
            profile_id,
            query.from_user.id
        )
    )

    await query.message.edit_text(
        "✅ Анкета тағы 14 күнге ұзартылды."
    )


# =========================================================
# TEXT ROUTER
# =========================================================

async def send_text(update, text):
    if hasattr(update, "message") and update.message:
        await update.message.reply_text(text)
    else:
        await update.get_bot().send_message(
            chat_id=update.effective_user.id,
            text=text
        )


async def text_router(update, context):
    text = update.message.text

    if text == "🏠 ПӘТЕР ІЗДЕУ":
        context.user_data["listing_index"] = 0

        conv = context.application.bot_data.get("search_conv")
        await search_start(update, context)
        return

    if text == "👥 БІРГЕ ПӘТЕР ІЗДЕУ":
        await roommate_start(update, context)
        return

    if text == "🧑‍💼 САТУШЫ / ЖАЛҒА БЕРУШІ":
        await seller_start(update, context)
        return

    if text == "❤️ САҚТАЛҒАНДАР":
        await saved_menu(update, context)
        return

    if text == "👤 МЕНІҢ ПРОФИЛІМ":
        await profile_menu(update, context)
        return

    if text == "✨ РЕЙТИНГ":
        await rating_candidates(update, context)
        return

    if text == "⭐ МЕНІҢ РЕЙТИНГІМ":
        await my_rating(update, context)
        return

    if text == "📞 АДМИНМЕН ХАБАРЛАСУ":
        await admin_contact(update, context)
        return

    if text == "⚙️ БАПТАУЛАР":
        await settings_menu(update, context)
        return

    if text == "🇰🇿 ҚАЗАҚША":
        set_language(update.effective_user.id, "kk")
        await show_main_menu(update, context)
        return

    if text == "🇷🇺 РУССКИЙ":
        set_language(update.effective_user.id, "ru")
        await show_main_menu(update, context)
        return


# =========================================================
# APPLICATION
# =========================================================

def build_application():
    init_db()

    application = (
        Application.builder()
        .token(TOKEN)
        .build()
    )

    # START
    application.add_handler(
        CommandHandler("start", start)
    )

    # ADMIN
    application.add_handler(
        CommandHandler("admin", admin_panel)
    )

    # LANGUAGE
    application.add_handler(
        CallbackQueryHandler(
            language_callback,
            pattern=r"^lang_(kk|ru)$"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            settings_language,
            pattern=r"^setlang_(kk|ru)$"
        )
    )

    # SELLER CONVERSATION
    seller_conv = ConversationHandler(
        entry_points=[
            MessageHandler(
                filters.Regex("^🧑‍💼 САТУШЫ / ЖАЛҒА БЕРУШІ$"),
                seller_start
            )
        ],
        states={
            SELL_TYPE: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, seller_type)
            ],
            SELL_CITY: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, seller_city)
            ],
            SELL_ROOMS: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, seller_rooms)
            ],
            SELL_ADDRESS: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, seller_address)
            ],
            SELL_PRICE: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, seller_price)
            ],
            SELL_ALLOWED: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, seller_allowed)
            ],
            SELL_FORBIDDEN: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, seller_forbidden)
            ],
            SELL_PHOTOS: [
                MessageHandler(filters.PHOTO, seller_photos),
                MessageHandler(filters.TEXT & ~filters.COMMAND, seller_photos)
            ],
            SELL_VIDEO: [
                MessageHandler(filters.VIDEO, seller_video),
                MessageHandler(filters.TEXT & ~filters.COMMAND, seller_video)
            ],
            SELL_PHONE: [
                MessageHandler(
                    filters.CONTACT | (filters.TEXT & ~filters.COMMAND),
                    seller_phone
                )
            ],
            SELL_EXTRA: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, seller_extra)
            ],
        },
        fallbacks=[],
        allow_reentry=True
    )

    application.add_handler(seller_conv)

    # SEARCH CONVERSATION
    search_conv = ConversationHandler(
        entry_points=[
            MessageHandler(
                filters.Regex("^🏠 ПӘТЕР ІЗДЕУ$"),
                search_start
            )
        ],
        states={
            SEARCH_TYPE: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, search_type)
            ],
            SEARCH_CITY: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, search_city)
            ],
        },
        fallbacks=[],
        allow_reentry=True
    )

    application.add_handler(search_conv)

    # ROOMMATE CONVERSATION
    roommate_conv = ConversationHandler(
        entry_points=[
            MessageHandler(
                filters.Regex("^👥 БІРГЕ ПӘТЕР ІЗДЕУ$"),
                roommate_menu
            )
        ],
        states={
            ROOM_CITY: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, roommate_city)
            ],
            ROOM_AGE: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, roommate_age)
            ],
            ROOM_BUDGET: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, roommate_budget)
            ],
            ROOM_EXTRA: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, roommate_extra)
            ],
        },
        fallbacks=[],
        allow_reentry=True
    )

    application.add_handler(roommate_conv)

    # CALLBACKS
    application.add_handler(
        CallbackQueryHandler(
            publish_listing,
            pattern=r"^listing_publish$"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            cancel_listing,
            pattern=r"^listing_cancel$"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            listing_skip,
            pattern=r"^listing_skip$"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            listing_save,
            pattern=r"^listing_save$"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            listing_select,
            pattern=r"^listing_select$"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            publish_roommate,
            pattern=r"^room_publish$"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            cancel_roommate,
            pattern=r"^room_cancel$"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            room_skip,
            pattern=r"^room_skip$"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            room_save,
            pattern=r"^room_save$"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            room_select,
            pattern=r"^room_select$"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            rate_user,
            pattern=r"^rate_"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            report_callback,
            pattern=r"^report_"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            admin_callback,
            pattern=r"^admin_"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            renew_listing,
            pattern=r"^renew_"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            delete_expired,
            pattern=r"^delete_expired_"
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            renew_roommate,
            pattern=r"^renewroom_"
        )
    )

    # MAIN MENU TEXT
    application.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            text_router
        )
    )

    # EXPIRATION CHECK
    if application.job_queue:
        application.job_queue.run_repeating(
            check_expired,
            interval=3600,
            first=30
        )

    return application


# =========================================================
# RUN
# =========================================================

if __name__ == "__main__":
    app = build_application()

    print("QAZAQ HOME BOT STARTED")

    app.run_polling(
        allowed_updates=Update.ALL_TYPES
    )
