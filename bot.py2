# =========================================================
# RATING
# =========================================================

async def rating_candidates(update, context):
    user_id = update.effective_user.id

    rows = db_execute(
        """
        SELECT *
        FROM interactions
        WHERE
        (seller_id=? AND buyer_rated=0)
        OR
        (buyer_id=? AND seller_rated=0)
        ORDER BY id DESC
        """,
        (user_id, user_id),
        fetchall=True
    )

    if not rows:
        await update.message.reply_text(
            "⭐ Қазір бағалайтын адам жоқ."
        )
        return

    for row in rows:
        if row["seller_id"] == user_id:
            target_id = row["buyer_id"]
            rating_type = "buyer"
            label = "🔎 САТЫП АЛУШЫНЫ БАҒАЛАУ"
        else:
            target_id = row["seller_id"]
            rating_type = "seller"
            label = "🏠 САТУШЫНЫ БАҒАЛАУ"

        target = db_execute(
            "SELECT first_name, username FROM users WHERE id=?",
            (target_id,),
            fetchone=True
        )

        if not target:
            continue

        name = target["first_name"] or target["username"] or "Қолданушы"

        keyboard = [
            [
                InlineKeyboardButton("⭐", callback_data=f"rate_{row['id']}_{target_id}_{rating_type}_1"),
                InlineKeyboardButton("⭐⭐", callback_data=f"rate_{row['id']}_{target_id}_{rating_type}_2"),
                InlineKeyboardButton("⭐⭐⭐", callback_data=f"rate_{row['id']}_{target_id}_{rating_type}_3"),
            ],
            [
                InlineKeyboardButton("⭐⭐⭐⭐", callback_data=f"rate_{row['id']}_{target_id}_{rating_type}_4"),
                InlineKeyboardButton("⭐⭐⭐⭐⭐", callback_data=f"rate_{row['id']}_{target_id}_{rating_type}_5"),
            ]
        ]

        await update.message.reply_text(
            f"{label}\n\n"
            f"👤 {name}\n\n"
            "Бағаңызды таңдаңыз:",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )


async def rate_user(update, context):
    query = update.callback_query
    await query.answer()

    parts = query.data.split("_")

    interaction_id = int(parts[1])
    target_id = int(parts[2])
    rating_type = parts[3]
    stars = int(parts[4])

    interaction = db_execute(
        "SELECT * FROM interactions WHERE id=?",
        (interaction_id,),
        fetchone=True
    )

    if not interaction:
        await query.message.reply_text(
            "❌ Байланыс табылмады."
        )
        return

    if query.from_user.id not in (
        interaction["seller_id"],
        interaction["buyer_id"]
    ):
        await query.message.reply_text(
            "❌ Бұл рейтинг сізге арналмаған."
        )
        return

    try:
        db_execute(
            """
            INSERT INTO ratings
            (interaction_id, from_user, to_user,
             rating_type, stars, comment, created_at)
            VALUES (?, ?, ?, ?, ?, '', ?)
            """,
            (
                interaction_id,
                query.from_user.id,
                target_id,
                rating_type,
                stars,
                now()
            )
        )
    except sqlite3.IntegrityError:
        await query.message.edit_text(
            "⚠️ Сіз бұл адамға бұрын рейтинг қойғансыз."
        )
        return

    if query.from_user.id == interaction["seller_id"]:
        db_execute(
            "UPDATE interactions SET buyer_rated=1 WHERE id=?",
            (interaction_id,)
        )
    else:
        db_execute(
            "UPDATE interactions SET seller_rated=1 WHERE id=?",
            (interaction_id,)
        )

    await query.message.edit_text(
        f"✅ Рейтинг қойылды: {'⭐' * stars}"
    )


